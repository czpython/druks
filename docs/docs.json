      {
        "label": "Website",
        "href": "https://druks.ai"
      },
      {
        "label": "Try it now",
        "href": "https://app.druks.ai/sign-in?utm_source=docs"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/czpython/druks"
    }
  },
  "navigation": {
