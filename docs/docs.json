{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Druks",
  "description": "AI agents work. You make the call. Druks runs Claude Code and Codex on your recurring engineering work, self-hosted or in the cloud, and asks a person before anything changes.",
  "seo": {
    "metatags": {
      "canonical": "https://docs.druks.ai"
    }
  },
  "colors": {
    "primary": "#00677b",
    "light": "#00677b",
    "dark": "#00677b"
  },
  "logo": {
    "light": "/assets/logo/web/DruksLockup_Light.svg",
    "dark": "/assets/logo/web/DruksLockup_Dark.svg",
    "href": "https://druks.ai"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
