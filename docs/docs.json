            "pages": [
              "container-runtimes/docker-desktop",
              "container-runtimes/colima"
            ]
          }
        ]
      },
      {
        "group": "Understand Druks",
        "pages": [
          "concepts",
          "licensing"
        ]
      },
      {
        "group": "Build an app",
        "pages": [
          "writing-an-app",
          "druks-ui",
          "files"
        ]
      },
      {
        "group": "Operate",
        "pages": [
          "deployment",
          "configuration",
          "connect-your-agent",
          "chat",
          "troubleshooting"
        ]
      },
      {
        "group": "Contribute",
        "pages": [
          "development",
          "releasing"
        ]
      }
    ]
