# Host-run development configuration. Copy to `druks.toml`.
# Reference: docs/configuration.md. This file holds no secret: a host-run server
# takes each secret from `.env` (docs/development.md).

# Schedule timezone and initial timezone for new accounts.
timezone = "UTC"

[identity]
mode = "none"
header = ""
jwks_url = ""
jwt_issuer = ""
jwt_audience = ""
jwt_identity_claim = "/email"

[urls]
endpoint = ""
webhook_host = ""

[sandbox]
service_url = ""
image = ""
issuer_url = ""
timeout = 180
