[project]
name = "druks-{{ name }}"
version = "0.1.0"
description = "{{ Name }} app for druks."
requires-python = ">=3.11"
dependencies = ["druks"]

[dependency-groups]
dev = [
    "pytest>=8.4.0",
    "pytest-asyncio>=1.3.0",
]

# The platform discovers this app here — installing the package is the
# whole registration.
[project.entry-points."druks.apps"]
{{ name }} = "druks_{{ name }}.app:{{ Name }}"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
# Everything in druks is async; without this, an async test fails confusingly.
asyncio_mode = "auto"
